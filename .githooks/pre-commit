#!/usr/bin/env bash
# 第 3 層（Security）+ 第 4 層（CI Quality Gate）的本機閘門。
# 用 git 原生 pre-commit hook，而不是 Claude Code hook：不論是 Claude Code、Hermes 還是 Codex 下 git commit，都會被擋。
#
# 安裝（每個 repo 一次）：
#   chmod +x .githooks/pre-commit
#   git config core.hooksPath .githooks
#
# 跳過方式只有 `git commit --no-verify`；CLAUDE.md 應明文禁止 agent 使用該參數。
set -uo pipefail

fail() { echo "[gate] FAIL: $1"; exit 1; }

staged_files=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$staged_files" ] && exit 0

# ---- 1/3 make check（只改 .md 時跳過，對應 RISK.md 低風險文件類） ----
if echo "$staged_files" | grep -qvE '\.md$'; then
  echo "[gate] 1/3 make check"
  make check || fail "make check 未通過"
else
  echo "[gate] 1/3 make check 跳過（只有 .md 變更）"
fi

# ---- 2/3 憑證掃描 ----
echo "[gate] 2/3 secrets scan"
if command -v gitleaks >/dev/null 2>&1; then
  # gitleaks v8.19+ 語法；舊版請改用：gitleaks protect --staged --redact
  gitleaks git --pre-commit --staged --redact || fail "gitleaks 發現疑似憑證"
else
  echo "[gate] WARN: gitleaks 未安裝（brew install gitleaks），改用簡易 grep"
  if git diff --cached -U0 | grep -E '^\+' | grep -v '^+++' \
     | grep -Eiq "(api[_-]?key|secret|password|passwd|token)[\"']?[[:space:]]*[:=][[:space:]]*[\"'][^\"']{8,}"; then
    fail "簡易 grep 發現疑似憑證（請安裝 gitleaks 取得更準確的結果）"
  fi
fi

# ---- 3/3 PHI pattern 掃描（用 perl 以兼容 macOS 與 Linux 的 regex 差異） ----
echo "[gate] 3/3 PHI scan"
added=$(git diff --cached -U0 | grep -E '^\+' | grep -v '^+++')

# 3a. 台灣身分證字號：格式夠特殊，單獨出現就擋
if echo "$added" | perl -ne 'exit 1 if /\b[A-Z][12][0-9]{8}\b/' ; then :; else
  fail "疑似身分證字號出現在新增內容中"
fi

# 3b. 院內病歷號：兩種格式
#     英文字母 + 5 位數字（如 J56218）；或 6–7 位純數字、可含前導 0（如 093951）
#     純數字格式太容易誤擋程式裡的一般數字（逾時毫秒數、port、PR 編號），所以不單獨擋，改用兩條規則：
#     注意：本檔案自己也會被掃描，註解裡的範例不要放到 5 個以上。
MRN='(?:[A-Z][0-9]{5}|[0-9]{6,7})'
PHI_KW='(?:病歷|病人|患者|歷號|chart|mrn|medical[ _-]?record|patient|case[ _-]?(?:no|id)|\bpid\b)'

#     規則 1：同一行同時出現病歷相關關鍵字與病歷號格式 → 擋
if echo "$added" | perl -ne "exit 1 if /$PHI_KW/i && /\\b$MRN\\b/"; then :; else
  fail "同一行出現病歷關鍵字與疑似病歷號（規則 1）"
fi

#     規則 2：單一檔案的新增內容含 ≥ MRN_DENSITY 個不同的病歷號格式 token（像是資料匯出或名單）→ 擋
MRN_DENSITY=${MRN_DENSITY:-5}
for f in $staged_files; do
  n=$(git diff --cached -U0 -- "$f" | grep -E '^\+' | grep -v '^+++' \
      | perl -ne "print \"\$1\n\" while /\\b($MRN)\\b/g" | sort -u | wc -l | tr -d ' ')
  if [ "$n" -ge "$MRN_DENSITY" ]; then
    fail "$f 新增內容含 $n 個不同的疑似病歷號（規則 2，門檻 $MRN_DENSITY）"
  fi
done

echo "[gate] PASS"
exit 0
